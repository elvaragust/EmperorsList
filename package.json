{
  "name": "emperorslist",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial, free army builder and game companion for Warhammer 40,000 (11th edition). Ships with no game data.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "fast-xml-parser": "4.5.3",
    "minisearch": "7.2.0",
    "peerjs": "1.5.5",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "2.1.9"
  }
}
